#!/usr/bin/env sh

if ! python scripts/generate_home_data.py --check; then
  echo "提交已阻止：assets/js/home-data.js 与 data/site-map.json 不一致。"
  echo "请运行：python scripts/generate_home_data.py"
  exit 1
fi

if ! python scripts/website_privacy_guard.py --check; then
  echo "提交已阻止：发现 HTML 页面缺少或使用了错误的 noindex 配置。"
  echo "请运行：python scripts/website_privacy_guard.py --fix"
  echo "修复后再提交。"
  exit 1
fi

if ! python scripts/validate_site_structure.py; then
  echo "提交已阻止：站点目录、文章路径或兼容路由存在不一致。"
  echo "请根据上方检查结果修复后再提交。"
  exit 1
fi

if ! python scripts/validate_content.py; then
  echo "提交已阻止：页面标题、描述、H1、图片 alt 或 DOM id 存在内容质量问题。"
  echo "请根据上方检查结果修复后再提交。"
  exit 1
fi

if ! python scripts/validate_home_css.py; then
  echo "提交已阻止：首页 CSS 存在无效覆盖、优先级或分层问题。"
  echo "请根据上方检查结果修复后再提交。"
  exit 1
fi

if ! python scripts/validate_style_css_usage.py; then
  echo "提交已阻止：公共 style.css 存在无生产引用规则或死 selector 分支。"
  echo "请删除无效规则或补齐实际 HTML/JS 引用后再提交。"
  exit 1
fi

if ! python scripts/validate_orphan_assets.py; then
  echo "提交已阻止：assets/js 或 assets/css 中存在无人引用的运行时资源。"
  echo "请删除迁移残留文件，或补齐生产页面引用后再提交。"
  exit 1
fi

if ! python scripts/validate_asset_budget.py; then
  echo "提交已阻止：静态 JavaScript/CSS 体积超过当前站点预算。"
  echo "请拆分或精简资源，确需扩大预算时应同步说明原因。"
  exit 1
fi

if ! python scripts/validate_javascript.py; then
  echo "提交已阻止：assets/js 中存在 JavaScript 语法错误，或当前环境缺少 Node.js。"
  echo "请安装 Node.js 并修复上方语法错误后再提交。"
  exit 1
fi
